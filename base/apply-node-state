#!/usr/bin/env bash
#
# apply-node-state — bring this node's KGSM units to the state its packages declare.
#
# Run by /usr/share/libalpm/hooks/zz-kgsm-node-apply.hook, PostTransaction, with the paths pacman
# changed on stdin. By then systemd-sysusers, systemd-tmpfiles and the daemon-reload have all run
# (their hooks sort ahead of this one), and each package's own scriptlet has applied the preset
# policy to its units — so what is left is the part that needs a running system: starting what is
# ready, and restarting what was replaced under it.
#
# Nothing here may fail the transaction. Every systemctl call is tolerated and reported; a chroot,
# an image build or a container without an init simply gets the report and no action.
#
set -uo pipefail

LIB="/usr/lib/kgsm-base/node-state.sh"
# shellcheck source=/dev/null
. "$LIB" 2>/dev/null || exit 0

note() { printf '   %s\n' "$*"; }
warn() { printf '\033[1;33m** %s\033[0m\n' "$*" >&2; }

# ── what this transaction touched ─────────────────────────────────────────────
#
# The hook fires on unit files, drop-ins and installed binaries alike, so the change is mapped back
# to the units it affects rather than read off the path. A binary is mapped through its owning
# package; a drop-in names its unit directly, which is what makes installing kgsm-web restart the
# API that now has a web root pointing at the bundle.

declare -A TOUCHED_PKG=() TOUCHED_UNIT=()
declare -a owners=()

while IFS= read -r target; do
    [[ -n "$target" ]] || continue
    case "$target" in
        usr/lib/systemd/system/*.d/*)
            unit="${target#usr/lib/systemd/system/}"
            TOUCHED_UNIT["${unit%%.d/*}"]=1
            ;;
    esac
    # kgsm_read_lines, not process substitution: this runs chrooted with no /proc, so /dev/fd does
    # not resolve and every such read would silently yield nothing.
    kgsm_read_lines owners "$(pacman -Qoq "/${target}" 2>/dev/null || true)"
    for owner in "${owners[@]}"; do
        TOUCHED_PKG["$owner"]=1
    done
done

kgsm_scan

if ! kgsm_have_systemd; then
    note "no running systemd here — nothing started or restarted"
    exec /usr/bin/kgsm-node-status
fi

# ── act ───────────────────────────────────────────────────────────────────────

run() {
    local out
    if out="$("$@" 2>&1)"; then
        note "$*"
        return 0
    fi
    warn "$* — left as it was"
    [[ -n "$out" ]] && printf '%s\n' "$out" | sed 's/^/     /' >&2
    return 0
}

# A socket-activated service holds the binary it was started from until it exits, and both of these
# exit on their own idle timer rather than when a deploy would like them to — so the pair comes
# down together and the socket is re-armed, which is what a new binary is picked up through.
restart_unit() {
    case "$1" in
        *.socket)
            run systemctl stop "$1" "${1%.socket}.service"
            run systemctl start "$1"
            ;;
        *)
            run systemctl restart "$1"
            ;;
    esac
}

started=0 restarted=0
for unit in "${KGSM_READY[@]}"; do
    pkg="${KGSM_UNIT_PKG[$unit]}"
    if ! kgsm_unit_is_active "$unit"; then
        run systemctl start "$unit" && started=$((started + 1))
    elif [[ -n "${TOUCHED_PKG[$pkg]:-}" || -n "${TOUCHED_UNIT[$unit]:-}" ]]; then
        restart_unit "$unit" && restarted=$((restarted + 1))
    fi
done

(( started || restarted )) && echo

exec /usr/bin/kgsm-node-status
