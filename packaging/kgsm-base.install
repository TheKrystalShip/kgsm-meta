# Every install is a cluster. The node accepts only sessions its cluster's auth anchor minted, so a
# machine with no cluster secret has nobody who can sign anyone in to it. On first install, a machine
# whose secret is still blank therefore founds a cluster of its own: a generated secret, and the
# founded-here record beside it — the SHA-256 of that secret — which is what switches this machine's
# auth anchor on (kgsm-auth-anchor's own install hook reads it).
#
# A machine meant to join a cluster somebody else runs is given that cluster's secret before this
# package is installed, or follows kgsm-meta/NODE-PROVISIONING.md §10·a after, and never has the
# record: its anchor stays installed and off, as the promotion candidate a cluster keeps.
#
# post_install only. An upgrade never founds anything: a machine installed before this existed is
# already clustered or already standing alone by decision, and neither is this hook's to change.

CLUSTER_ENV=/etc/kgsm/kgsm-cluster.env
FOUNDED=/etc/kgsm/cluster-founded

blank_secret() {
    ! grep -qE '^[[:space:]]*Cluster__Secret[[:space:]]*=[[:space:]]*[^[:space:]]' "$CLUSTER_ENV" 2>/dev/null
}

post_install() {
    [[ -f "$CLUSTER_ENV" ]] || return 0
    blank_secret || return 0

    # 32 random bytes as hex, from coreutils alone: openssl is not a dependency of this package.
    local secret
    secret="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    [[ ${#secret} -eq 64 ]] || { printf '  could not generate a cluster secret; %s left blank\n' "$CLUSTER_ENV"; return 0; }

    sed -i "s/^[[:space:]]*Cluster__Secret[[:space:]]*=.*$/Cluster__Secret=${secret}/" "$CLUSTER_ENV"
    printf '%s\n' "$secret" | sha256sum | cut -d' ' -f1 > "$FOUNDED"
    chmod 0644 "$FOUNDED"

    cat <<'MSG'

  This machine founded a cluster of its own: a secret was generated in /etc/kgsm/kgsm-cluster.env,
  and the auth anchor installed beside the node holds this cluster's accounts. People sign in there.

  To join a cluster somebody else runs instead, follow kgsm-meta/NODE-PROVISIONING.md §10·a — it
  switches this machine's anchor off before the secret changes, which is what keeps the two clusters'
  accounts from meeting.

MSG
}
